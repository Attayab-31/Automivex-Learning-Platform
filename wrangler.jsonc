{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automivex-learning",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/verify/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "automivex-learning",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://learn.automivex.com",
    "EMAIL_FROM": "Automivex <support@automivex.com>",
    "SMTP_HOST": "smtp.hostinger.com",
    "SMTP_PORT": "465",
    "ADMIN_EMAILS": "REPLACE_WITH_YOUR_ADMIN_EMAIL",
    "LINKEDIN_URL": "https://www.linkedin.com/company/automivex/",
    "YOUTUBE_URL": "",
    "TIKTOK_URL": "",
    "GITHUB_ORG_URL": "https://github.com/Attayab-31",
    "WHATSAPP_COMMUNITY_URL": ""
  },
  "observability": { "enabled": true }
}
